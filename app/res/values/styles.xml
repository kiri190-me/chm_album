<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="ViewerTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!-- 보기 화면: 뒤의 목록이 비쳐 보여서, 아래로 끌어 닫을 때 사진이 목록 칸으로 줄어드는 모습이 보인다 -->
    <style name="ViewerTranslucentTheme" parent="ViewerTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
